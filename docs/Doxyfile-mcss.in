# Configured into the build tree next to Doxyfile, so both stay in sync with
# the project version and paths.
@INCLUDE                = @CMAKE_CURRENT_BINARY_DIR@/Doxyfile
GENERATE_HTML           = NO
GENERATE_XML            = YES
XML_PROGRAMLISTING      = NO
M_FILE_TREE_EXPAND_LEVELS = 8
# YES: undocumented members are what the reader most needs to know about.
M_SHOW_UNDOCUMENTED = YES
M_LINKS_NAVBAR1 = setup \
    "overview overview-bicop overview-vinecop discrete conditional inference" \
    "annotated classvinecopulib_1_1_bicop classvinecopulib_1_1_fit_controls_bicop classvinecopulib_1_1_vinecop classvinecopulib_1_1_fit_controls_vinecop classvinecopulib_1_1_r_vine_structure classvinecopulib_1_1_r_vine_trees classvinecopulib_1_1_triangular_array"

M_LINKS_NAVBAR2 = \
    "namespaces namespacevinecopulib namespacevinecopulib_1_1bicop__families namespacevinecopulib_1_1tools__stats" \
    license \
    "<a href=\"https://github.com/vinecopulib/vinecopulib\">GitHub</a>"
