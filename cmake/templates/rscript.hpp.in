#pragma once

//! 1 when Rscript was found at configure time. The parity tests skip when 0,
//! so the suite builds and runs without R.
#define VINECOPULIB_HAS_RSCRIPT @VINECOPULIB_HAS_RSCRIPT@

#define RSCRIPT "\"@RSCRIPT_EXECUTABLE@\" --vanilla "

// Absolute paths: the tests must not depend on the working directory.
#define TEST_BICOP "\"@r_script_dir@/test_bicop_parametric.R\""
#define TEST_BICOP_DERIV "\"@r_script_dir@/test_bicop_derivatives.R\""
#define TEST_VINECOP "\"@r_script_dir@/test_vinecop_parametric.R\""
#define TEST_VINECOP_DERIV "\"@r_script_dir@/test_vinecop_derivatives.R\""
