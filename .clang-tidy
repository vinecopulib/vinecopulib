Checks: >
  -*,
  bugprone-*,
  performance-*,
  readability-*,
  modernize-*,  
  cppcoreguidelines-*,
  portability-*,
  clang-analyzer-*,
  misc-*,
  hicpp-*,
  boost-*

WarningsAsErrors: ''

HeaderFilterRegex: '.*/vinecopulib/(include|test|examples)/'
HeaderFileExtensions:         ['', 'h','hh','hpp','ipp','hxx']
FormatStyle: file
